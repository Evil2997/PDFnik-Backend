# /home/dmitriy/PycharmProjects/FastAPI-Learning/.env.example
# repo: PDFnik-Backend
#
# Copy to .env and fill in real values.
# Never commit .env to git.

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Whisper transcription model.
# Options (speed vs accuracy tradeoff):
#   tiny    — fastest, lowest accuracy
#   base    — good balance for short voice messages (default)
#   small   — better accuracy, ~2x slower than base
#   medium  — high accuracy, ~4x slower than base
#   large-v3 — best accuracy, ~10x slower, requires more RAM/VRAM
#
# For Russian speech large-v3 is recommended if GPU is available.
# On CPU, base or small is the practical maximum.
TRANSCRIBE_MODEL=base
TRANSCRIBE_DEVICE=cpu
TRANSCRIBE_COMPUTE_TYPE=int8
TRANSCRIBE_THREADS=4
TRANSCRIBE_WORKERS=1
TRANSCRIBE_BEAM_SIZE=5
TRANSCRIBE_PATIENCE=1.0
TRANSCRIBE_VAD=false
TRANSCRIBE_LANG=auto
